<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" id="agl-service-radio" version="1.0">
  <name>agl-service-radio</name>
  <icon src="icon.svg"/>
  <content src="config.xml" type="application/vnd.agl.service"/>
  <description>This is a demo Radio application</description>
  <author>Scott Murray &lt;scott.murray@konsulko.com&gt;</author>
  <license>APL 2.0</license>
  <feature name="urn:AGL:widget:required-api">
    <param name="lib/libradio-binding.so" value="local" />
  </feature>
  <feature name="urn:AGL:widget:provided-api">
    <param name="radio" value="ws" />
  </feature>
  <feature name="urn:AGL:widget:required-permission">
    <param name="urn:AGL:permission::public:hidden" value="required" />
    <param name="urn:AGL:permission::public:no-htdocs" value="required" />
  </feature>
</widget>
